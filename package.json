{
  "name": "niltavi-identity",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit --project preview/tsconfig.json && tsc --noEmit --project web/tsconfig.json",
    "test:lab": "playwright test",
    "test:service": "npm run build:service && playwright test --config playwright.service.config.ts",
    "test:account": "npm run build:service && node acceptance/browser-auth.mjs",
    "test:docker": "npm run build:service && node acceptance/docker.mjs",
    "build:service": "tsc --project tsconfig.service.json",
    "build:web": "vite build --config web/vite.config.ts && tsx --tsconfig web/tsconfig.json web/prerender.tsx",
    "identity": "node dist/cli.js",
    "test": "npm run check && npm run test:lab",
    "preview:build": "vite build --config preview/vite.config.ts",
    "preview:lab": "npm run preview:build && node --import tsx preview/server.ts",
    "test:preview": "playwright test --config playwright.preview.config.ts"
  },
  "devDependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "8.3.0",
    "@gravity-ui/icons": "2.23.1",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/oidc-provider": "9.13.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "openid-client": "6.9.1",
    "react": "19.2.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.2.0",
    "selfsigned": "5.5.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "jose": "6.2.18",
    "nodemailer": "10.6.1",
    "oidc-provider": "9.15.1",
    "pg": "8.23.1",
    "tencentcloud-sdk-nodejs-ses": "4.1.271",
    "undici": "7.30.2"
  }
}
